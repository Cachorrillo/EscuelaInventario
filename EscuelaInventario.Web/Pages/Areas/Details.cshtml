@page "{id:int}"
@model EscuelaInventario.Web.Pages.Areas.DetailsModel

@{
    ViewData["Title"] = "Inventario por área";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        <h1>
            Área @Model.Area.Numero
        </h1>

        <p class="text-muted mb-0">
            Activos actualmente asignados a esta área.
        </p>
    </div>

    <div class="d-flex gap-2">

        <a asp-page-handler="ExportarJps"
           asp-route-id="@Model.Area.Id"
           class="btn btn-success">
            Exportar JPS a Excel
        </a>

        <a asp-page="Index"
           class="btn btn-secondary">
            Volver a áreas
        </a>

    </div>

</div>

<hr />


<!-- FILTROS -->
<div class="card mb-4">

    <div class="card-header">
        <strong>Filtros de búsqueda</strong>
    </div>

    <div class="card-body">

        <form method="get">

            <input type="hidden"
                   name="id"
                   value="@Model.Area.Id" />

            <div class="row">

                <div class="col-md-3">
                    <div class="mb-3">

                        <label asp-for="Placa"
                               class="form-label">
                            Últimos números de placa
                        </label>

                        <input asp-for="Placa"
                               class="form-control"
                               placeholder="Ej. 0004" />

                    </div>
                </div>


                <div class="col-md-3">
                    <div class="mb-3">

                        <label asp-for="Buscar"
                               class="form-label">
                            Búsqueda general
                        </label>

                        <input asp-for="Buscar"
                               class="form-control"
                               placeholder="Descripción, marca, modelo o serie" />

                    </div>
                </div>


                <div class="col-md-3">
                    <div class="mb-3">

                        <label asp-for="EstadoId"
                               class="form-label">
                            Estado
                        </label>

                        <select asp-for="EstadoId"
                                asp-items="Model.Estados"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                        </select>

                    </div>
                </div>


                <div class="col-md-3">
                    <div class="mb-3">

                        <label asp-for="ModoAdquisicionId"
                               class="form-label">
                            Modo de adquisición
                        </label>

                        <select asp-for="ModoAdquisicionId"
                                asp-items="Model.ModosAdquisicion"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                        </select>

                    </div>
                </div>

            </div>


            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    Filtrar
                </button>

                <a asp-page="Details"
                   asp-route-id="@Model.Area.Id"
                   class="btn btn-outline-secondary">
                    Limpiar filtros
                </a>

            </div>

        </form>

    </div>

</div>


<!-- RESULTADOS -->
<div class="mb-3">

    <strong>Resultados:</strong>
    @Model.Activos.Count

</div>


<!-- TABLA -->
@if (!Model.Activos.Any())
{
    <div class="alert alert-info">
        Esta área no tiene activos asignados actualmente.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-bordered align-middle">

            <thead>
                <tr>
                    <th>Placa</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Situación</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Serie</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var activo in Model.Activos)
                {
                    <tr>

                        <td>
                            @activo.Placa
                        </td>

                        <td>
                            @activo.Descripcion
                        </td>

                        <td>
                            @activo.EstadoActivo.Nombre
                        </td>

                        <td>

                            @if (activo.SituacionActivo.Codigo == "ACTIVO")
                            {
                                <span class="badge bg-success">
                                    @activo.SituacionActivo.Nombre
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @activo.SituacionActivo.Nombre
                                </span>
                            }

                        </td>

                        <td>
                            @(activo.Marca ?? "-")
                        </td>

                        <td>
                            @(activo.Modelo ?? "-")
                        </td>

                        <td>
                            @(activo.Serie ?? "-")
                        </td>

                        <td>

                            <a asp-page="/Activos/Details"
                               asp-route-id="@activo.Id"
                               class="btn btn-sm btn-outline-primary">
                                Ver
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}