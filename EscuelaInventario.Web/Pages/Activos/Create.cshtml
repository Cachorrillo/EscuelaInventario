@page
@model EscuelaInventario.Web.Pages.Activos.CreateModel

@{
    ViewData["Title"] = "Nuevo activo";
}

<h1>Nuevo activo</h1>

<p class="text-muted">
    Registre un nuevo activo en el inventario institucional.
</p>

<hr />

<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>

    <div class="row">

        <div class="col-md-8">

            <h5 class="mb-3">Información del activo</h5>

            <div class="mb-3">
                <label asp-for="Input.Descripcion"
                       class="form-label">
                    Descripción *
                </label>

                <input asp-for="Input.Descripcion"
                       class="form-control" />

                <span asp-validation-for="Input.Descripcion"
                      class="text-danger">
                </span>
            </div>

        </div>

        <div class="col-md-4">

            <div class="mb-3">
                <label class="form-label">
                    Placa
                </label>

                <input class="form-control"
                       value="Se asignará automáticamente"
                       disabled />

                <div class="form-text">
                    El sistema generará la siguiente placa disponible.
                </div>
            </div>

        </div>

    </div>


    <div class="row">

        <div class="col-md-4">
            <div class="mb-3">

                <label asp-for="Input.Marca"
                       class="form-label">
                    Marca
                </label>

                <input asp-for="Input.Marca"
                       class="form-control" />

            </div>
        </div>


        <div class="col-md-4">
            <div class="mb-3">

                <label asp-for="Input.Modelo"
                       class="form-label">
                    Modelo
                </label>

                <input asp-for="Input.Modelo"
                       class="form-control" />

            </div>
        </div>


        <div class="col-md-4">
            <div class="mb-3">

                <label asp-for="Input.Serie"
                       class="form-label">
                    Serie
                </label>

                <input asp-for="Input.Serie"
                       class="form-control" />

            </div>
        </div>

    </div>


    <div class="row">

        <div class="col-md-4">
            <div class="mb-3">

                <label asp-for="Input.FechaAdquisicion"
                       class="form-label">
                    Fecha de adquisición
                </label>

                <input asp-for="Input.FechaAdquisicion"
                       type="date"
                       class="form-control" />

            </div>
        </div>


        <div class="col-md-4">
            <div class="mb-3">

                <label asp-for="Input.Precio"
                       class="form-label">
                    Precio
                </label>

                <input asp-for="Input.Precio"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="Input.Precio"
                      class="text-danger">
                </span>

            </div>
        </div>


        <div class="col-md-4">
            <div class="mb-3">

                <label asp-for="Input.ModoAdquisicionId"
                       class="form-label">
                    Modo de adquisición
                </label>

                <select asp-for="Input.ModoAdquisicionId"
                        asp-items="Model.ModosAdquisicion"
                        class="form-select">

                    <option value="">
                        -- Seleccione --
                    </option>

                </select>

            </div>
        </div>

    </div>


    <hr />

    <h5 class="mb-3">Asignación inicial</h5>


    <div class="row">

        <div class="col-md-6">

            <div class="mb-3">

                <label asp-for="Input.AreaActualId"
                       class="form-label">
                    Área *
                </label>

                <select asp-for="Input.AreaActualId"
                        asp-items="Model.Areas"
                        class="form-select">

                    <option value="0">
                        -- Seleccione un área --
                    </option>

                </select>

                <span asp-validation-for="Input.AreaActualId"
                      class="text-danger">
                </span>

            </div>

        </div>


        <div class="col-md-6">

            <div class="mb-3">

                <label asp-for="Input.EstadoActivoId"
                       class="form-label">
                    Estado físico *
                </label>

                <select asp-for="Input.EstadoActivoId"
                        asp-items="Model.Estados"
                        class="form-select">

                    <option value="0">
                        -- Seleccione un estado --
                    </option>

                </select>

                <span asp-validation-for="Input.EstadoActivoId"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>


    <div class="mb-3">

        <label asp-for="Input.Observaciones"
               class="form-label">
            Observaciones del activo
        </label>

        <textarea asp-for="Input.Observaciones"
                  class="form-control"
                  rows="3">
        </textarea>

    </div>


    <hr />

    <h5 class="mb-3">Registro de inclusión</h5>


    <div class="row">

        <div class="col-md-6">

            <div class="mb-3">

                <label asp-for="Input.FechaMovimiento"
                       class="form-label">
                    Fecha del registro *
                </label>

                <input asp-for="Input.FechaMovimiento"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="Input.FechaMovimiento"
                      class="text-danger">
                </span>

            </div>

        </div>


        <div class="col-md-6">

            <div class="mb-3">

                <label asp-for="Input.ResponsableId"
                       class="form-label">
                    Responsable
                </label>

                <select asp-for="Input.ResponsableId"
                        asp-items="Model.Responsables"
                        class="form-select">

                    <option value="">
                        -- Sin especificar --
                    </option>

                </select>

            </div>

        </div>

    </div>


    <div class="mb-4">

        <label asp-for="Input.ObservacionMovimiento"
               class="form-label">
            Observación del registro
        </label>

        <textarea asp-for="Input.ObservacionMovimiento"
                  class="form-control"
                  rows="3">
        </textarea>

    </div>


    <div class="d-flex gap-2">

        <button type="submit"
                class="btn btn-primary">
            Registrar activo
        </button>

        <a asp-page="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </div>

</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}