@page
@model EscuelaInventario.Web.Pages.Activos.IndexModel

@{
    ViewData["Title"] = "Inventario general";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Inventario general</h1>
        <p class="text-muted">
            Consulta de los activos registrados en la institución.
        </p>
    </div>

    <a asp-page="Create"
       class="btn btn-primary">
        Nuevo activo
    </a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>Placa</th>
            <th>Descripción</th>
            <th>Área actual</th>
            <th>Estado</th>
            <th>Situación</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Serie</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var activo in Model.Activos)
        {
            <tr>
                <td>@activo.Placa</td>

                <td>@activo.Descripcion</td>

                <td>
                    @activo.AreaActual?.Nombre
                </td>

                <td>
                    @activo.EstadoActivo?.Nombre
                </td>

                <td>
                    @if (activo.SituacionActivo?.Codigo == "ACTIVO")
                    {
                        <span class="badge bg-success">
                            @activo.SituacionActivo.Nombre
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @activo.SituacionActivo?.Nombre
                        </span>
                    }
                </td>

                <td>@activo.Marca</td>
                <td>@activo.Modelo</td>
                <td>@activo.Serie</td>

                <td>
                    <a asp-page="Details"
                       asp-route-id="@activo.Id"
                       class="btn btn-sm btn-outline-primary">
                        Ver
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>