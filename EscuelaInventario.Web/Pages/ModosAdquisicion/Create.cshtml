@page
@model EscuelaInventario.Web.Pages.ModosAdquisicion.CreateModel

@{
    ViewData["Title"] = "Nuevo modo de adquisición";
}

<h1>Nuevo modo de adquisición</h1>

<p class="text-muted">
    Registre un nuevo método de adquisición de activos.
</p>

<hr />

<div class="row">
    <div class="col-md-6">

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="ModoAdquisicion.Nombre"
                       class="form-label">
                    Nombre
                </label>

                <input asp-for="ModoAdquisicion.Nombre"
                       class="form-control" />

                <span asp-validation-for="ModoAdquisicion.Nombre"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="ModoAdquisicion.Observaciones"
                       class="form-label">
                    Observaciones
                </label>

                <textarea asp-for="ModoAdquisicion.Observaciones"
                          class="form-control"
                          rows="4">
                </textarea>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Guardar
            </button>

            <a asp-page="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}