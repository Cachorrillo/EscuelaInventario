@page
@model EscuelaInventario.Web.Pages.Responsables.IndexModel

@{
    ViewData["Title"] = "Responsables";
}

@if (TempData["MensajeExito"] != null)
{
    <div id="mensajeExito"
         class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["MensajeExito"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Responsables</h1>
        <p class="text-muted">
            Administración de las personas responsables de registrar operaciones.
        </p>
    </div>

    <a asp-page="Create"
       class="btn btn-primary">
        Nuevo responsable
    </a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Estado</th>
            <th>Observaciones</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var responsable in Model.Responsables)
        {
            <tr>
                <td>@responsable.Nombre</td>

                <td>
                    @if (responsable.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>

                <td>@responsable.Observaciones</td>

                <td>
                    <a asp-page="Edit"
                       asp-route-id="@responsable.Id"
                       class="btn btn-sm btn-outline-primary">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        setTimeout(function () {
            const mensaje = document.getElementById('mensajeExito');

            if (mensaje) {
                const alerta = bootstrap.Alert.getOrCreateInstance(mensaje);
                alerta.close();
            }
        }, 3000);
    </script>
}