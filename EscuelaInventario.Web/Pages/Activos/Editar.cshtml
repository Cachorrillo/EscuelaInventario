@page "{id:int}"
@model EscuelaInventario.Web.Pages.Activos.EditarModel

@{
    ViewData["Title"] = "Editar activo";
}

<h1>Editar información del activo</h1>

<p class="text-muted">
    Corrija o actualice únicamente los datos administrativos permitidos.
</p>

<hr />

<form method="post">

    <input type="hidden"
           asp-for="Input.ActivoId" />

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>

    <div class="card mb-4">

        <div class="card-header">
            <strong>Datos no modificables desde esta operación</strong>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-3">
                    <strong>Placa</strong>
                    <div>@Model.Placa</div>
                </div>

                <div class="col-md-3">
                    <strong>Área actual</strong>
                    <div>@Model.AreaActual</div>
                </div>

                <div class="col-md-3">
                    <strong>Estado físico</strong>
                    <div>@Model.EstadoActual</div>
                </div>

                <div class="col-md-3">
                    <strong>Situación</strong>
                    <div>@Model.SituacionActual</div>
                </div>

            </div>

        </div>

    </div>


    <div class="row">

        <div class="col-md-12">

            <div class="mb-3">

                <label asp-for="Input.Descripcion"
                       class="form-label">
                    Descripción *
                </label>

                <input asp-for="Input.Descripcion"
                       class="form-control" />

                <span asp-validation-for="Input.Descripcion"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>


    <div class="row">

        <div class="col-md-4">

            <div class="mb-3">

                <label asp-for="Input.Marca"
                       class="form-label">
                    Marca
                </label>

                <input asp-for="Input.Marca"
                       class="form-control" />

            </div>

        </div>


        <div class="col-md-4">

            <div class="mb-3">

                <label asp-for="Input.Modelo"
                       class="form-label">
                    Modelo
                </label>

                <input asp-for="Input.Modelo"
                       class="form-control" />

            </div>

        </div>


        <div class="col-md-4">

            <div class="mb-3">

                <label asp-for="Input.Serie"
                       class="form-label">
                    Serie
                </label>

                <input asp-for="Input.Serie"
                       class="form-control" />

            </div>

        </div>

    </div>


    <div class="row">

        <div class="col-md-4">

            <div class="mb-3">

                <label asp-for="Input.FechaAdquisicion"
                       class="form-label">
                    Fecha de adquisición
                </label>

                <input asp-for="Input.FechaAdquisicion"
                       type="date"
                       class="form-control" />

            </div>

        </div>


        <div class="col-md-4">

            <div class="mb-3">

                <label asp-for="Input.Precio"
                       class="form-label">
                    Precio
                </label>

                <input asp-for="Input.Precio"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="Input.Precio"
                      class="text-danger">
                </span>

            </div>

        </div>


        <div class="col-md-4">

            <div class="mb-3">

                <label asp-for="Input.ModoAdquisicionId"
                       class="form-label">
                    Modo de adquisición
                </label>

                <select asp-for="Input.ModoAdquisicionId"
                        asp-items="Model.ModosAdquisicion"
                        class="form-select">

                    <option value="">
                        -- Sin especificar --
                    </option>

                </select>

            </div>

        </div>

    </div>


    <div class="mb-4">

        <label asp-for="Input.ObservacionesActivo"
               class="form-label">
            Observaciones del activo
        </label>

        <textarea asp-for="Input.ObservacionesActivo"
                  class="form-control"
                  rows="3">
        </textarea>

    </div>


    <hr />

    <h5 class="mb-3">Registro de la modificación</h5>


    <div class="row">

        <div class="col-md-6">

            <div class="mb-3">

                <label asp-for="Input.FechaMovimiento"
                       class="form-label">
                    Fecha de modificación *
                </label>

                <input asp-for="Input.FechaMovimiento"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="Input.FechaMovimiento"
                      class="text-danger">
                </span>

            </div>

        </div>


        <div class="col-md-6">

            <div class="mb-3">

                <label asp-for="Input.ResponsableId"
                       class="form-label">
                    Responsable
                </label>

                <select asp-for="Input.ResponsableId"
                        asp-items="Model.Responsables"
                        class="form-select">

                    <option value="">
                        -- Sin especificar --
                    </option>

                </select>

            </div>

        </div>

    </div>


    <div class="mb-3">

        <label asp-for="Input.Motivo"
               class="form-label">
            Motivo
        </label>

        <input asp-for="Input.Motivo"
               class="form-control"
               placeholder="Ej. Corrección de información" />

    </div>


    <div class="mb-4">

        <label asp-for="Input.ObservacionMovimiento"
               class="form-label">
            Detalle de la modificación
        </label>

        <textarea asp-for="Input.ObservacionMovimiento"
                  class="form-control"
                  rows="4"
                  placeholder="Ej. Se corrige la marca registrada incorrectamente.">
        </textarea>

    </div>


    <div class="d-flex gap-2">

        <button type="submit"
                class="btn btn-primary">
            Guardar modificación
        </button>

        <a asp-page="Details"
           asp-route-id="@Model.Input.ActivoId"
           class="btn btn-secondary">
            Cancelar
        </a>

    </div>

</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}