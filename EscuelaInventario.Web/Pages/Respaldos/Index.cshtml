@page
@model EscuelaInventario.Web.Pages.Respaldos.IndexModel

@{
    ViewData["Title"] = "Respaldos";
}

<div class="d-flex justify-content-between align-items-start mb-3">

    <div>
        <h1>Respaldos</h1>

        <p class="text-muted mb-0">
            Cree una copia de seguridad completa de la base de datos institucional.
        </p>
    </div>

</div>

<hr class="mb-4" />

@if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
{
    <div class="alert alert-success">
        <strong>Respaldo completado.</strong>

        <div class="mt-2">
            @Model.MensajeExito
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.NombreArchivo))
        {
            <div class="mt-3">
                <strong>Archivo:</strong>
                @Model.NombreArchivo
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.RutaRespaldo))
        {
            <div class="mt-1">
                <strong>Ubicación:</strong>
                <code>@Model.RutaRespaldo</code>
            </div>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.MensajeError))
{
    <div class="alert alert-danger">
        <strong>No se pudo crear el respaldo.</strong>

        <div class="mt-2">
            @Model.MensajeError
        </div>
    </div>
}

<div class="card mb-4">

    <div class="card-header">
        <strong>Crear respaldo de la base de datos</strong>
    </div>

    <div class="card-body">

        <p>
            El sistema creará un archivo
            <strong>.bak</strong>
            con una copia completa de la base de datos actual.
        </p>

        <p class="text-muted">
            El archivo se guardará en la carpeta de respaldos
            configurada por SQL Server y tendrá la fecha y hora
            incluidas en su nombre.
        </p>

        <form method="post"
              asp-page-handler="Crear">

            <button type="submit"
                    class="btn btn-primary"
                    onclick="return confirm('¿Desea crear un respaldo de la base de datos ahora?');">

                Crear respaldo ahora

            </button>

        </form>

    </div>

</div>

<div class="alert alert-warning">

    <strong>Importante:</strong>

    un respaldo guardado solamente en esta computadora protege contra
    errores de datos, pero no contra la pérdida o daño completo del equipo.

    <div class="mt-2">
        Se recomienda copiar periódicamente los archivos
        <strong>.bak</strong>
        a una memoria USB, disco externo u otro medio institucional seguro.
    </div>

</div>
